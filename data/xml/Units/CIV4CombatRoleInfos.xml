			<Help>TXT_KEY_COMBATROLE_SIEGE_HELP</Help>
			<iAttackPercent>100</iAttackPercent>
			<iDefensePercent>60</iDefensePercent>
			<iMaxHP>80</iMaxHP>
			<iSpeed>1</iSpeed>
			<iDodge>0</iDodge>
			<iCritBonus>0</iCritBonus>
			<bAntiFlank>0</bAntiFlank>
			<FrontRow><Action>NONE</Action><iActions>0</iActions></FrontRow>
			<MiddleRow><Action>BOMBARD</Action><iActions>1</iActions></MiddleRow>
			<RearRow><Action>BOMBARD</Action><iActions>2</iActions></RearRow>
			<HomeRow>REAR</HomeRow>
