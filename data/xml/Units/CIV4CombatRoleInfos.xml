			</DefaultUnitCombats>
		</CombatRoleInfo>
		<CombatRoleInfo>
			<Type>COMBATROLE_ASSASSIN</Type>
			<Description>TXT_KEY_COMBATROLE_ASSASSIN</Description>
			<Help>TXT_KEY_COMBATROLE_ASSASSIN_HELP</Help>
			<iAttackPercent>120</iAttackPercent>
			<iDefensePercent>60</iDefensePercent>
			<iMaxHP>60</iMaxHP>
			<iSpeed>7</iSpeed>
			<iDodge>15</iDodge>
			<iCritBonus>15</iCritBonus>
			<bAntiFlank>0</bAntiFlank>
			<FrontRow><Action>STAB</Action><iActions>1</iActions></FrontRow>
			<MiddleRow><Action>STAB</Action><iActions>2</iActions></MiddleRow>
			<RearRow><Action>STAB</Action><iActions>1</iActions></RearRow>
			<HomeRow>MIDDLE</HomeRow>
			<iAutoPick>8</iAutoPick>
			<!-- the owner's answer Q6: recon units with Marksman free (every FfH assassin) -->
			<DefaultUnitCombats>
				<UnitCombat>UNITCOMBAT_RECON</UnitCombat>
			</DefaultUnitCombats>
			<DefaultFreePromotion>PROMOTION_MARKSMAN</DefaultFreePromotion>
		</CombatRoleInfo>
		<CombatRoleInfo>
			<Type>COMBATROLE_ARCHER</Type>
			<Description>TXT_KEY_COMBATROLE_ARCHER</Description>
			<Help>TXT_KEY_COMBATROLE_ARCHER_HELP</Help>
			<iAttackPercent>100</iAttackPercent>
			<iDefensePercent>60</iDefensePercent>
			<iMaxHP>80</iMaxHP>
			<iSpeed>4</iSpeed>
			<iDodge>0</iDodge>
			<iCritBonus>0</iCritBonus>
			<bAntiFlank>0</bAntiFlank>
			<FrontRow><Action>SHOOT</Action><iActions>1</iActions></FrontRow>
			<MiddleRow><Action>SHOOT</Action><iActions>2</iActions></MiddleRow>
			<RearRow><Action>SHOOT</Action><iActions>2</iActions></RearRow>
			<HomeRow>MIDDLE</HomeRow>
			<iAutoPick>3</iAutoPick>
			<!-- archers, and the Airship (the only land unit with UNITCOMBAT_NAVAL) -->
			<DefaultUnitCombats>
				<UnitCombat>UNITCOMBAT_ARCHER</UnitCombat>
				<UnitCombat>UNITCOMBAT_NAVAL</UnitCombat>
			</DefaultUnitCombats>
		</CombatRoleInfo>
		<CombatRoleInfo>
			<Type>COMBATROLE_SIEGE</Type>
