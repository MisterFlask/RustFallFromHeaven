			<iDefensePercent>80</iDefensePercent>
			<iMaxHP>100</iMaxHP>
			<iSpeed>6</iSpeed>
			<iDodge>10</iDodge>
			<iCritBonus>0</iCritBonus>
			<bAntiFlank>0</bAntiFlank>
			<FrontRow><Action>CHARGE</Action><iActions>2</iActions></FrontRow>
			<MiddleRow><Action>STRIKE</Action><iActions>1</iActions></MiddleRow>
			<RearRow><Action>STRIKE</Action><iActions>1</iActions></RearRow>
			<HomeRow>FRONT</HomeRow>
