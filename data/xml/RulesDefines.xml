<?xml version="1.0"?>
<!-- Tuning values of this game's own rules (not FFH2's): read after GlobalDefines.xml,
     GlobalDefinesAlt.xml and PythonCallbackDefines.xml, like them. Each system's doc lists
     its values: docs/CULTURE.md for the CULTURE_* defines, docs/ARMIES.md for the ARMY_* ones, docs/GOVERNORS.md for the
     GOVERNOR_* ones; the ENGAGEMENT_* ones are engagement combat's (phase 6). Percentages are integers
     (100 = 1.0). -->
<Civ4Defines xmlns="x-schema:CIV4GlobalDefinesSchema.xml">
	<!-- ==== Cultural channels (GAMEOPTION_CULTURE_ACTIONS, docs/CULTURE.md) ==== -->
	<!-- percent of a channelling city's culture rate diverted to its channel -->
	<Define>
		<DefineName>CULTURE_CHANNEL_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<!-- plots within which a channel works in full; beyond, it falls with the square of the distance -->
	<Define>
		<DefineName>CULTURE_CHANNEL_FULL_RANGE</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<!-- plots beyond which a channel does nothing -->
	<Define>
		<DefineName>CULTURE_CHANNEL_RANGE</DefineName>
		<iDefineIntVal>20</iDefineIntVal>
	</Define>
	<!-- percent of a city's own culture rate that resists revolt pressure each turn -->
	<Define>
		<DefineName>CULTURE_REVOLT_RESIST_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<!-- revolt pressure resisted each turn per defender of the city's team -->
	<Define>
		<DefineName>CULTURE_REVOLT_GARRISON</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- percent of its revolt pressure a city sheds each turn -->
	<Define>
		<DefineName>CULTURE_REVOLT_FADE_PERCENT</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<!-- revolt pressure per point of unhappiness -->
	<Define>
		<DefineName>CULTURE_REVOLT_UNHAPPY_STEP</DefineName>
		<iDefineIntVal>25</iDefineIntVal>
	</Define>
	<!-- most unhappiness revolt pressure causes -->
	<Define>
		<DefineName>CULTURE_REVOLT_UNHAPPY_MAX</DefineName>
		<iDefineIntVal>4</iDefineIntVal>
	</Define>
	<!-- revolt pressure at which a city falls into revolt (disorder) -->
	<Define>
		<DefineName>CULTURE_REVOLT_DISORDER</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
	<!-- one caster's revolt pressure at which a city joins it -->
	<Define>
		<DefineName>CULTURE_REVOLT_FLIP</DefineName>
		<iDefineIntVal>300</iDefineIntVal>
	</Define>
	<!-- turns of a hostile channel per point of the target leader's memory of it -->
	<Define>
		<DefineName>CULTURE_REVOLT_MEMORY_TURNS</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<!-- Spread Religion: chance a turn per culture channelled, in hundredths of a percent, before distance and the religions present -->
	<Define>
		<DefineName>CULTURE_SPREAD_PER_CULTURE</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
	<!-- Spread Religion: most chance a turn, in hundredths of a percent -->
	<Define>
		<DefineName>CULTURE_SPREAD_MAX</DefineName>
		<iDefineIntVal>2500</iDefineIntVal>
	</Define>
	<!-- the AI: most of its cities channelling revolt against one civilization -->
	<Define>
		<DefineName>CULTURE_AI_MAX_HOSTILE_PER_TARGET</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- turns per point a leader's memory of cultural hostility or friendship fades -->
	<Define>
		<DefineName>CULTURE_MEMORY_DECAY_TURNS</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
	<!-- most points of cultural hostility or friendship a leader remembers -->
	<Define>
		<DefineName>CULTURE_MEMORY_MAX</DefineName>
		<iDefineIntVal>8</iDefineIntVal>
	</Define>
	<!-- ==== Armies (GAMEOPTION_ARMIES, docs/ARMIES.md) ==== -->
	<Define>
		<DefineName>ARMY_SUPPLY_RANGE</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ARMY_TRANSIT_STALL_TURNS</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<!-- ==== Governors (GAMEOPTION_GOVERNORS, docs/GOVERNORS.md) ==== -->
	<Define>
		<DefineName>GOVERNOR_DIRECT_RULE_CITIES</DefineName>
		<iDefineIntVal>4</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_DIRECT_RULE_SWAP_COOLDOWN</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_BENCH_SURPLUS</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_BENCH_GEN_CHANCE</DefineName>
		<iDefineIntVal>15</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_SWAP_PENALTY</DefineName>
		<iDefineIntVal>25</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_SWAP_TURNS</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>GOVERNOR_MAX_TRAITS</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- ==== Engagement combat (GAMEOPTION_ENGAGEMENTS; phase 6 of the owner's spec, whose
	     parameter names follow each comment; roles: Units/CIV4CombatRoleInfos.xml, plot
	     changes: iEngagementSlotsChange of terrains and features; formation battles, revision 4:
	     docs/ENGAGEMENTS.md) ==== -->
	<!-- SLOTS_BASE: units each side commits to an engagement (a large unit counts two), before the
	     defended plot's changes; a side's grid has 3 rows and max(2, ceil((slots + 2) / 3)) lanes -->
	<Define>
		<DefineName>ENGAGEMENT_SLOTS_BASE</DefineName>
		<iDefineIntVal>8</iDefineIntVal>
	</Define>
	<!-- SLOTS_MIN: the fewest slots a side has -->
	<Define>
		<DefineName>ENGAGEMENT_SLOTS_MIN</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>
	<!-- the slots change of a hills plot (hills are a plot type, not a terrain); a feature's change
	     adds to it, the terrain's does not -->
	<Define>
		<DefineName>ENGAGEMENT_SLOTS_HILLS</DefineName>
		<iDefineIntVal>-2</iDefineIntVal>
	</Define>
	<!-- SLOTS_RIVER: attacker slots lost attacking across a river; units that cross rivers freely
	     (bRiver) may fill them -->
	<Define>
		<DefineName>ENGAGEMENT_SLOTS_RIVER</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- SLOTS_DEFENSE_DIVISOR: percent of a city's current defence per attacker slot lost -->
	<Define>
		<DefineName>ENGAGEMENT_SLOTS_DEFENSE_DIVISOR</DefineName>
		<iDefineIntVal>25</iDefineIntVal>
	</Define>
	<!-- SUMMON_EXTRA_SLOTS: summons a side may add in battle beyond its slots (phase 7) -->
	<Define>
		<DefineName>ENGAGEMENT_SUMMON_EXTRA_SLOTS</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- BASE_DAMAGE: B in a hit's expected damage B x A / (A + Dv), in HP, before the action's
	     percentages (an even hit takes 20 HP; six of them kill a frontline unit) -->
	<Define>
		<DefineName>ENGAGEMENT_BASE_DAMAGE</DefineName>
		<iDefineIntVal>40</iDefineIntVal>
	</Define>
	<!-- r: a hit deals its expected damage x r, r drawn in RAND_MIN..=RAND_MAX percent -->
	<Define>
		<DefineName>ENGAGEMENT_DAMAGE_RAND_MIN</DefineName>
		<iDefineIntVal>80</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_DAMAGE_RAND_MAX</DefineName>
		<iDefineIntVal>120</iDefineIntVal>
	</Define>
	<!-- ROUNDS: rounds of a formation battle; in each, every unit acts once per action it has from
	     its row, one pass per action -->
	<Define>
		<DefineName>ENGAGEMENT_ROUNDS</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>
	<!-- LARGE_HP_PERCENT: a large unit's (bLarge) HP, in percent of its role's -->
	<Define>
		<DefineName>ENGAGEMENT_LARGE_HP_PERCENT</DefineName>
		<iDefineIntVal>150</iDefineIntVal>
	</Define>
	<!-- FIRST_STRIKE_SPEED: speed a first strike adds (a chance first strike, when rolled at the
	     battle's start) -->
	<Define>
		<DefineName>ENGAGEMENT_FIRST_STRIKE_SPEED</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- EXTRA_ACTION_TIER: units of this tier and above, and heroes, get EXTRA_ACTIONS more actions
	     in their role's best row -->
	<Define>
		<DefineName>ENGAGEMENT_EXTRA_ACTION_TIER</DefineName>
		<iDefineIntVal>4</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_EXTRA_ACTIONS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- MISS_PERCENT: the miss chance of a physical action, plus the kind's (SHOOT, BOMBARD below)
	     and the target role's iDodge, at most 95 -->
	<Define>
		<DefineName>ENGAGEMENT_MISS_PERCENT</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_SHOOT_MISS_PERCENT</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_BOMBARD_MISS_PERCENT</DefineName>
		<iDefineIntVal>15</iDefineIntVal>
	</Define>
	<!-- CRIT_PERCENT: the crit chance of a strike, charge, stab or shoot, plus the hitter role's
	     iCritBonus, at most 95; a crit deals CRIT_DAMAGE_PERCENT of the hit (a melee crit also knocks
	     the target back a row when the cells behind it are free) -->
	<Define>
		<DefineName>ENGAGEMENT_CRIT_PERCENT</DefineName>
		<iDefineIntVal>10</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_CRIT_DAMAGE_PERCENT</DefineName>
		<iDefineIntVal>150</iDefineIntVal>
	</Define>
	<!-- CHARGE_BONUS: percent a flanker's charge adds to its damage in the first round, where
	     flanking works (no city, no forest or jungle) -->
	<Define>
		<DefineName>ENGAGEMENT_CHARGE_BONUS</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
	<!-- SPLASH_PERCENT: a splash (collateral damage, a spell's) hits each of the target's neighbours
	     for this percent of a hit on it -->
	<Define>
		<DefineName>ENGAGEMENT_SPLASH_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<!-- BOLT_PERCENT: the power of a caster's magic bolt (one target), when it knows no damage spell
	     (a damage spell has 100 and splashes) -->
	<Define>
		<DefineName>ENGAGEMENT_BOLT_PERCENT</DefineName>
		<iDefineIntVal>60</iDefineIntVal>
	</Define>
	<!-- HEAL_PERCENT: a heal restores BASE_DAMAGE x this percent x r -->
	<Define>
		<DefineName>ENGAGEMENT_HEAL_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<!-- The ground (the defended plot's; multiplied together): in a city the attacker's SHOOT deals
	     CITY_ATTACKER_SHOT_PERCENT; in a forest or jungle SHOOT and BOMBARD deal FOREST_RANGED_PERCENT on
	     both sides; on hills every attacker hit deals HILLS_ATTACKER_PERCENT and the defender's SHOOT
	     and BOMBARD HILLS_DEFENDER_RANGED_PERCENT -->
	<Define>
		<DefineName>ENGAGEMENT_CITY_ATTACKER_SHOT_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_FOREST_RANGED_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_HILLS_ATTACKER_PERCENT</DefineName>
		<iDefineIntVal>75</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>ENGAGEMENT_HILLS_DEFENDER_RANGED_PERCENT</DefineName>
		<iDefineIntVal>125</iDefineIntVal>
	</Define>
	<!-- AUTO_MIN_HP_PCT: the auto-pick skips units below this percent of their HP while healthier
	     ones of the role are left -->
	<Define>
		<DefineName>ENGAGEMENT_AUTO_MIN_HP_PERCENT</DefineName>
		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<!-- RECON_REVEAL_RANGE: plots within which a recon unit reveals an army's formation (phase 7) -->
	<Define>
		<DefineName>ENGAGEMENT_RECON_REVEAL_RANGE</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- battle reports the game keeps: those of the current and the previous turn's battles, and
	     of this many latest battles (the oldest are dropped) -->
	<Define>
		<DefineName>ENGAGEMENT_REPORTS_KEPT</DefineName>
		<iDefineIntVal>128</iDefineIntVal>
	</Define>
	<!-- battle logs (the full record the client replays) kept: those of the current and the
	     previous turn's battles, and of this many latest battles; older reports keep their summary -->
	<Define>
		<DefineName>ENGAGEMENT_REPORT_LOGS_KEPT</DefineName>
		<iDefineIntVal>32</iDefineIntVal>
	</Define>
	<!-- PREVIEW_RUNS: battles the attack preview plays on its own RNG for its forecast (each
	     side's expected losses, the chance the plot falls, each unit's chance to fall) -->
	<Define>
		<DefineName>ENGAGEMENT_PREVIEW_RUNS</DefineName>
		<iDefineIntVal>200</iDefineIntVal>
	</Define>
</Civ4Defines>
