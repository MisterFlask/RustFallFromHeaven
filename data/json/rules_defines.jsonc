{
  // Tuning values of this game's own rules (not FFH2's): read after GlobalDefines.xml,
  //     GlobalDefinesAlt.xml and PythonCallbackDefines.xml, like them. Each system's doc lists
  //     its values: docs/CULTURE.md for the CULTURE_* defines, docs/ARMIES.md for the ARMY_* ones, docs/GOVERNORS.md for the
  //     GOVERNOR_* ones; the ENGAGEMENT_* ones are engagement combat's (phase 6). Percentages are integers
  //     (100 = 1.0).
  // ==== Cultural channels (GAMEOPTION_CULTURE_ACTIONS, docs/CULTURE.md) ====
  // percent of a channelling city's culture rate diverted to its channel
  "CULTURE_CHANNEL_PERCENT": 50,
  // plots within which a channel works in full; beyond, it falls with the square of the distance
  "CULTURE_CHANNEL_FULL_RANGE": 5,
  // plots beyond which a channel does nothing
  "CULTURE_CHANNEL_RANGE": 20,
  // percent of a city's own culture rate that resists revolt pressure each turn
  "CULTURE_REVOLT_RESIST_PERCENT": 50,
  // revolt pressure resisted each turn per defender of the city's team
  "CULTURE_REVOLT_GARRISON": 2,
  // percent of its revolt pressure a city sheds each turn
  "CULTURE_REVOLT_FADE_PERCENT": 5,
  // revolt pressure per point of unhappiness
  "CULTURE_REVOLT_UNHAPPY_STEP": 25,
  // most unhappiness revolt pressure causes
  "CULTURE_REVOLT_UNHAPPY_MAX": 4,
  // revolt pressure at which a city falls into revolt (disorder)
  "CULTURE_REVOLT_DISORDER": 100,
  // one caster's revolt pressure at which a city joins it
  "CULTURE_REVOLT_FLIP": 300,
  // turns of a hostile channel per point of the target leader's memory of it
  "CULTURE_REVOLT_MEMORY_TURNS": 5,
  // Spread Religion: chance a turn per culture channelled, in hundredths of a percent, before distance and the religions present
  "CULTURE_SPREAD_PER_CULTURE": 100,
  // Spread Religion: most chance a turn, in hundredths of a percent
  "CULTURE_SPREAD_MAX": 2500,
  // the AI: most of its cities channelling revolt against one civilization
  "CULTURE_AI_MAX_HOSTILE_PER_TARGET": 2,
  // turns per point a leader's memory of cultural hostility or friendship fades
  "CULTURE_MEMORY_DECAY_TURNS": 10,
  // most points of cultural hostility or friendship a leader remembers
  "CULTURE_MEMORY_MAX": 8,
  // ==== Armies (GAMEOPTION_ARMIES, docs/ARMIES.md) ====
  "ARMY_TRANSIT_STALL_TURNS": 5,
  // ==== Supply lines (docs/SUPPLY.md) ====
  // the most a supply line may cost: an army is supplied when the cheapest path from it to a
  //      source (a city of its owner's team not in occupation, a ship of its owner) costs at most this
  "SUPPLY_LINE_BUDGET": 24,
  // the cost of entering a plot with a route (anyone's)
  "SUPPLY_COST_ROAD": 1,
  // the cost of entering a plot of the owner's team without a route
  "SUPPLY_COST_OWN": 1,
  // the cost of entering any other land plot
  "SUPPLY_COST_LAND": 3,
  // turns of Hunger (no healing, no recruits) after the line is cut, before Starvation
  "SUPPLY_HUNGER_TURNS": 2,
  // Starvation: percent of its full HP each unit loses at the start of each of its owner's turns
  "STARVATION_DAMAGE_PERCENT": 10,
  // Starvation: the loss stops at this percent of the unit's full HP
  "STARVATION_FLOOR_PERCENT": 25,
  // Starvation: percent change of the damage the army's units deal in a battle
  "STARVATION_DAMAGE_DEALT_PERCENT": -25,
  // ==== The sea, phase 1: range, boats, wear (docs/NAVAL.md, section 3) ====
  // a team's range at sea: the water steps from its ports within which its ships and boats are
  //      in range (plus each known tech's sea_range_change)
  "SEA_RANGE": 8,
  // out of range: percent of its full HP a sea unit or a unit in boats loses at its owner's turn start
  "SEA_ATTRITION_PERCENT": 15,
  // water plots a unit in boats enters a turn (plus its civilization's embarked_moves_change)
  "EMBARKED_MOVES": 1,
  // the strength a unit in boats defends with, without any modifier
  "EMBARKED_STRENGTH": 1,
  // wear: turn starts a warship spends outside a city before its strength is lowered
  "SEA_WEAR_FREE_TURNS": 10,
  // wear: percent of strength lost per turn start beyond the free ones
  "SEA_WEAR_PERCENT": 5,
  // wear: the most strength wear takes, in percent
  "SEA_WEAR_MAX_PERCENT": 50,
  // seas (docs/NAVAL.md, 4.1): a water area of fewer plots has no sea
  "SEA_MIN_PLOTS": 6,
  // seas: the plots a sea is cut to (an area gets plots / this seas, rounded, at least 1)
  "SEA_TARGET_PLOTS": 40,
  // a sea is closed to a team when an enemy's strength on Patrol there is at least this percent
  //      of the team's (and above 0)
  "SEA_HOLD_PERCENT": 200,
  // a besieged city with an open harbour: percent of the city's heal and of its Sentinels' repair
  "PORT_SIEGE_HEAL_PERCENT": 50,
  // the most warships of a side that fire into a battle on the coast
  "SHORE_FIRE_SHIPS": 3,
  // the least odds (percent) a ship on Patrol needs against a plot's defender to intercept
  "INTERCEPT_MIN_ODDS": 50,
  // ==== Governors (docs/GOVERNORS.md) ====
  // percent chance a new governor has a trait (governor_traits.jsonc, drawn uniformly)
  "GOVERNOR_TRAIT_CHANCE": 50,
  // the suitability (percent) a city needs for a role the player chooses for it
  "GOVERNOR_ROLE_MIN_SUITABILITY": 75,
  // percent added to a role's weight in a city's proposal when the role is one of the owner's priorities
  "GOVERNOR_PRIORITY_WEIGHT": 30,
  // the empire priorities a player may set
  "GOVERNOR_MAX_PRIORITIES": 2,
  // ==== Engagement combat (GAMEOPTION_ENGAGEMENTS; phase 6 of the owner's spec, whose
  //      parameter names follow each comment; a unit's rows and rank preference: engage_rows and
  //      engage_row_order in units.jsonc; plot
  //      changes: iEngagementSlotsChange of terrains and features; formation battles, revision 4:
  //      docs/ENGAGEMENTS.md) ====
  // SLOTS_BASE: units each side commits to an engagement (a large unit counts two), before the
  //      defended plot's changes; a side's grid has 3 rows and max(2, ceil((slots + 2) / 3)) lanes
  "ENGAGEMENT_SLOTS_BASE": 8,
  // SLOTS_MIN: the fewest slots a side has
  "ENGAGEMENT_SLOTS_MIN": 3,
  // the slots change of a hills plot (hills are a plot type, not a terrain); a feature's change
  //      adds to it, the terrain's does not
  "ENGAGEMENT_SLOTS_HILLS": -2,
  // SLOTS_RIVER: attacker slots lost attacking across a river; units that cross rivers freely
  //      (bRiver) may fill them
  "ENGAGEMENT_SLOTS_RIVER": 2,
  // SUMMON_EXTRA_SLOTS: summons a side may add in battle beyond its slots (phase 7)
  "ENGAGEMENT_SUMMON_EXTRA_SLOTS": 2,
  // BASE_DAMAGE: B in a hit's expected damage B x A / (A + Dv), in HP, before the action's
  //      percentages (an even hit takes 20 HP; six of them kill a frontline unit)
  "ENGAGEMENT_BASE_DAMAGE": 40,
  // r: a hit deals its expected damage x r, r drawn in RAND_MIN..=RAND_MAX percent
  "ENGAGEMENT_DAMAGE_RAND_MIN": 80,
  "ENGAGEMENT_DAMAGE_RAND_MAX": 120,
  // ROUNDS: rounds of a formation battle; in each, every unit acts once per action it has from
  //      its row, one pass per action
  "ENGAGEMENT_ROUNDS": 3,
  // FIRST_STRIKE_SPEED: speed a first strike adds (a chance first strike, when rolled at the
  //      battle's start)
  "ENGAGEMENT_FIRST_STRIKE_SPEED": 2,
  // EXTRA_ACTION_TIER: units of this tier and above, and heroes, get EXTRA_ACTIONS more actions
  //      in their best row (the row of their engage_rows with the most actions)
  "ENGAGEMENT_EXTRA_ACTION_TIER": 4,
  "ENGAGEMENT_EXTRA_ACTIONS": 1,
  // SHOOT_MISS_PERCENT, BOMBARD_MISS_PERCENT: what a SHOOT or a BOMBARD takes off the hitter's
  //      chance to hit (its accuracy less the target's evasion: docs/UNIT_STATS.md)
  "ENGAGEMENT_SHOOT_MISS_PERCENT": 10,
  "ENGAGEMENT_BOMBARD_MISS_PERCENT": 15,
  // CRIT_DAMAGE_PERCENT: what a crit deals, in percent of the hit (the crit chance is the hitter's
  //      crit stat, at most 95; a melee crit also knocks the target back a row when the cells behind
  //      it are free)
  "ENGAGEMENT_CRIT_DAMAGE_PERCENT": 150,
  // CHARGE_BONUS: percent a flanker's charge adds to its damage in the first round, where
  //      flanking works (no city, no forest or jungle)
  "ENGAGEMENT_CHARGE_BONUS": 100,
  // SPLASH_PERCENT: a splash (collateral damage, a spell's) hits each of the target's neighbours
  //      for this percent of a hit on it
  "ENGAGEMENT_SPLASH_PERCENT": 50,
  // BOLT_PERCENT: the power of a caster's magic bolt (one target), when it knows no damage spell
  //      (a damage spell has its battle_power, 100 when absent)
  "ENGAGEMENT_BOLT_PERCENT": 60,
  // HEAL_PERCENT: a heal restores BASE_DAMAGE x this percent x r (a unit's own heal_percent
  //      takes its place)
  "ENGAGEMENT_HEAL_PERCENT": 50,
  // Attack patterns (docs/UNIT_ROLES.md): each extra hit of an action, in percent of a hit on
  //      its target. VOLLEY: the unit its kind would hit in each lane beside the target's;
  //      PIERCE: every other unit in the target's lanes; SWEEP: every other unit in its row (a
  //      heal's sweep heals each hurt ally of the row for this percent of its heal); CLEAVE: the
  //      front unit of each lane beside it; TRAMPLE: the unit behind it.
  "ENGAGEMENT_VOLLEY_PERCENT": 50,
  "ENGAGEMENT_PIERCE_PERCENT": 50,
  "ENGAGEMENT_SWEEP_PERCENT": 50,
  "ENGAGEMENT_CLEAVE_PERCENT": 60,
  "ENGAGEMENT_TRAMPLE_PERCENT": 60,
  // MISSILE_PERCENT: a missile's strike (Fireball, Meteor: one hit from outside the field, the
  //      plot's own defence in the target's Dv, no ground rules) deals this percent of BASE_DAMAGE's
  //      hit: 50 keeps the strength it had before formation battles doubled BASE_DAMAGE
  "ENGAGEMENT_MISSILE_PERCENT": 50,
  // The ground (the defended plot's; multiplied together): in a city the attacker's SHOOT deals
  //      CITY_ATTACKER_SHOT_PERCENT; in a forest or jungle SHOOT and BOMBARD deal FOREST_RANGED_PERCENT on
  //      both sides; on hills every attacker hit deals HILLS_ATTACKER_PERCENT and the defender's SHOOT
  //      and BOMBARD HILLS_DEFENDER_RANGED_PERCENT
  "ENGAGEMENT_CITY_ATTACKER_SHOT_PERCENT": 50,
  "ENGAGEMENT_FOREST_RANGED_PERCENT": 50,
  "ENGAGEMENT_HILLS_ATTACKER_PERCENT": 85,
  "ENGAGEMENT_HILLS_DEFENDER_RANGED_PERCENT": 125,
  // AUTO_MIN_HP_PCT: the auto-pick skips units below this percent of their HP while healthier
  //      ones of the same kind (the action of the row a unit prefers) are left
  "ENGAGEMENT_AUTO_MIN_HP_PERCENT": 50,
  // TACTIC_VETERAN_LEVEL: a unit of this level or above is a veteran for the Vanguard tactic
  //      (docs/TACTICS.md), as is a unit with the Hero promotion
  "TACTIC_VETERAN_LEVEL": 4,
  // RECON_REVEAL_RANGE: plots within which a recon unit reveals an army's formation (phase 7)
  "ENGAGEMENT_RECON_REVEAL_RANGE": 2,
  // battle reports the game keeps: those of the current and the previous turn's battles, and
  //      of this many latest battles (the oldest are dropped)
  "ENGAGEMENT_REPORTS_KEPT": 128,
  // battle logs (the full record the client replays) kept: those of the current and the
  //      previous turn's battles, and of this many latest battles; older reports keep their summary
  "ENGAGEMENT_REPORT_LOGS_KEPT": 32,
  // PREVIEW_RUNS: battles the attack preview plays on its own RNG for its forecast (each
  //      side's expected losses, the chance the plot falls, each unit's chance to fall)
  "ENGAGEMENT_PREVIEW_RUNS": 200,
  // ==== Sieges and Sentinels (docs/SIEGES.md). A walled city's Sentinels (a building's
  //      iSentinels) fight in the defender's front row; their base values are UNIT_SENTINEL's
  //      (iHP, iAttack, iDefense), their HP and Dv times (100 + the city's total defence) / 100. ====
  // SENTINEL_REPAIR_PERCENT: percent of its max HP a Sentinel repairs at its city's turn while
  //      the city is not besieged
  "SENTINEL_REPAIR_PERCENT": 10,
  // SIEGE_BOMBARD_FLOOR_PERCENT: a bombard never takes a soldier in the city below this percent
  //      of its HP (Sentinels have no floor)
  "SIEGE_BOMBARD_FLOOR_PERCENT": 50,
  // ==== National units (docs/PORTING.md, "Changes from FFH2"). A national class's limit
  //      (max_player_instances) is the number its owner trains at the normal cost; past it, each
  //      one costs this percent of the normal cost. A class with hard_limit keeps FFH2's limit. ====
  "NATIONAL_UNIT_OVER_LIMIT_COST_PERCENT": 500,
  // ==== Research paths (research_paths.jsonc; docs/PORTING.md, "Changes from FFH2"). A player
  //      committed to a path researches its techs this percent faster. ====
  "RESEARCH_PATH_PERCENT": 100,
  // ==== City works (docs/WORKS.md). There are no worker units: each city's work crews improve its
  //      land, lay its roads and launch its fishing boats; army units build roads and forts. ====
  // CITY_WORK_RATE: the build progress a city's crews add each turn (FFH2's Worker: 100), before
  //      the owner's work rate modifiers. At 50 the AI's empires develop about as they did with
  //      workers; at 100 the game ran some 40 turns ahead by turn 200 (docs/WORKS.md, "Measures")
  "CITY_WORK_RATE": 50,
  // CITY_WORK_ROAD_RANGE: a city lays a road toward another city of its owner at most this many
  //      plots away
  "CITY_WORK_ROAD_RANGE": 8,
  // FIELD_WORK_RATE: the build progress an army unit adds each turn to a road, a fort or a card's
  //      field work
  "FIELD_WORK_RATE": 50,
  // ==== Anarchy and advanced start: values FFH2 read from a table of game settings that is gone
  //      (docs/PORTING.md, "Changes from FFH2") ====
  // ANARCHY_LENGTH_PERCENT: percent applied to every anarchy length, after the game speed's
  "ANARCHY_LENGTH_PERCENT": 50,
  // ADVANCED_START_POINTS: an advanced start's points, before the world size and game speed
  //      percents
  "ADVANCED_START_POINTS": 600
}
