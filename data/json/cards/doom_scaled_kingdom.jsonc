  "text": {
    "TXT_KEY_DOOM_SCALED_KINGDOM": "The Scaled Kingdom",
    "TXT_KEY_DOOM_SCALED_KINGDOM_HELP": "A new civilization, the Scaled Kingdom, rises in the largest unowned region of jungle and marsh: three cities, each with a Palisade and two Lizardman Rangers, and its hero the Slitherking (a Lizardman Assassin, attack 90). Its units move through jungle and marsh at the cost of open ground, with +50% defence there. -2 attitude toward the civilizations whose land is within 6 plots of its cities. It knows the techs half the civilizations know. Played only where the region has room for three cities, with a free player slot.",
    "TXT_KEY_UNIT_SLITHERKING": "The Slitherking",
    "TXT_KEY_UNIT_SLITHERKING_PEDIA": "The Slitherking crawled out of the deepest marsh with a crown on his head and nobody left alive to ask where he found it.",
    "TXT_KEY_UNIT_SLITHERKING_STRATEGY": "A Lizardman Assassin hero with attack 90: it strikes the enemy's casters first.",
    "TXT_KEY_PROMOTION_SCALED_NATIVE": "Swampborn",
    "TXT_KEY_PROMOTION_SCALED_NATIVE_HELP": "[ICON_BULLET]Moves through jungle and marsh at the cost of open ground.[NEWLINE][ICON_BULLET]+50% defence in jungle and marsh.",
    "TXT_KEY_BUILDING_PALACE_SCALED_KINGDOM": "Palace",
    "TXT_KEY_CIV_SCALED_KINGDOM_DESC": "The Scaled Kingdom",
    "TXT_KEY_CIV_SCALED_KINGDOM_SHORT_DESC": "Scaled Kingdom",
    "TXT_KEY_CIV_SCALED_KINGDOM_ADJECTIVE": "Scaled",
    "TXT_KEY_CIV_SCALED_KINGDOM_HELP": "[ICON_BULLET]Its units move through jungle and marsh at the cost of open ground, with +50% defence there.[NEWLINE][ICON_BULLET]Its hunters, rangers, assassins, beastmasters and druids are lizardmen, as the Clan of Embers'.[NEWLINE][ICON_BULLET]Hero: the Slitherking.",
    "TXT_KEY_CIV_SCALED_KINGDOM_PEDIA": "The Scaled Kingdom is the lizardmen of the deep marshes, gathered at last under one crown.",
    "TXT_KEY_CITY_SCALED_KINGDOM_1": "Sslith",
    "TXT_KEY_CITY_SCALED_KINGDOM_2": "Mirefang",
    "TXT_KEY_CITY_SCALED_KINGDOM_3": "Hissing Pools",
    "TXT_KEY_CITY_SCALED_KINGDOM_4": "Scalewater",
    "TXT_KEY_CITY_SCALED_KINGDOM_5": "Coldblood",
    "TXT_KEY_CITY_SCALED_KINGDOM_6": "Rotreed",
    "TXT_KEY_CITY_SCALED_KINGDOM_7": "Ssarak",
    "TXT_KEY_CITY_SCALED_KINGDOM_8": "Greenmaw",
    "TXT_KEY_LEADER_SLITHERKING": "The Slitherking",
    "TXT_KEY_LEADER_SLITHERKING_PEDIA": "The Slitherking rules the lizardmen because the last three who tried to are in his belly."
  }
