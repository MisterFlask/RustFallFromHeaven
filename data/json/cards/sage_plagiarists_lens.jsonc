// The Plagiarist's Lens (docs/DECKS.md 3.1 and 9.1: Sage, band III, needs Arcane Lore; "once, learn
// a secret tech held by a civ you have met"). A once-a-game card spell, not a national building:
// the card's one effect is the copy, chosen when cast, and a building's completion has no choice.
// The choice: a card another civilization's team knows that the caster's team has met and lacks.
// Each holder's leader thinks less of the copier (-2, `ai_attitude_extra`). Rules:
// crates/ffh-core/src/ffh/cards/world_spells_2.rs.
{
  "techs": [
    {
      "type": "TECH_CARD_PLAGIARISTS_LENS",
      "description": "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS",
      "help": "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS_HELP",
      "civilopedia": "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS_PEDIA",
      "advisor": "ADVISOR_SCIENCE",
      "cost": -1,
      "advanced_start_cost": -1,
      "band": 3,
      "and_pre_reqs": ["TECH_ARCANE_LORE"],
      "card_suit": "UNITCLASS_SCIENTIST",
      "flavors": {"FLAVOR_SCIENCE": 1}
    }
  ],
  "spells": [
    {
      "type": "SPELL_PLAGIARISTS_LENS",
      "description": "TXT_KEY_SPELL_PLAGIARISTS_LENS",
      "civilopedia": "TXT_KEY_SPELL_PLACEHOLDER_PEDIA",
      "help": "TXT_KEY_SPELL_PLAGIARISTS_LENS_HELP",
      "tech_prereq": "TECH_CARD_PLAGIARISTS_LENS",
      "once": true,
      "target": "choice",
      "display_when_disabled": true,
      "has_casted": true,
      "py_targets": "targetsPlagiaristsLens(pCaster)",
      "py_target_label": "labelInfo(pCaster, iChoice, 'TechType')",
      "py_result": "spellPlagiaristsLens(pCaster)",
      "button": "Art/Interface/Buttons/Equipment/BlackMirror.dds"
    }
  ],
  "text": {
    "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS": "The Plagiarist's Lens",
    "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS_HELP": "[ICON_BULLET]World spell, once a game: the Plagiarist's Lens.[NEWLINE][ICON_BULLET]Your team learns a great-person card another civilization you have met knows, of your choice.[NEWLINE][ICON_BULLET]Every civilization that knows it: -2 attitude toward you.",
    "TXT_KEY_TECH_CARD_PLAGIARISTS_LENS_PEDIA": "A lens ground to read what is written in another scholar's mind. Its maker never wrote anything of his own.",
    "TXT_KEY_SPELL_PLAGIARISTS_LENS": "The Plagiarist's Lens",
    "TXT_KEY_SPELL_PLAGIARISTS_LENS_HELP": "[ICON_BULLET]The target: a great-person card known by a civilization you have met, that your team lacks.[NEWLINE][ICON_BULLET]Your team learns it.[NEWLINE][ICON_BULLET]Every civilization that knows it: -2 attitude toward you."
  }
}
