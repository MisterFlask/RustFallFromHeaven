  "text": {
    "TXT_KEY_TECH_CARD_CONDOTTIERI": "The Condottieri Free State",
    "TXT_KEY_TECH_CARD_CONDOTTIERI_HELP": "[ICON_BULLET]World spell, once: the Free Companies are born as your vassal, in two cities on free sites within 8 plots of your borders.[NEWLINE][ICON_BULLET]They start with six Mercenaries, 1000 gold and the Captain-General, a hero (a Champion with Hero, attack 130).[NEWLINE][ICON_BULLET]Their cities make double gold; they buy units at 2 gold per hammer left, under any civic.",
    "TXT_KEY_TECH_CARD_CONDOTTIERI_PEDIA": "A charter for the free companies: land, a flag, and a treasury of their own.[NEWLINE][NEWLINE]Expert: found them where the next war will be fought; their gold buys an army a turn.",
    "TXT_KEY_SPELL_CONDOTTIERI": "The Condottieri Free State",
    "TXT_KEY_SPELL_CONDOTTIERI_HELP": "[ICON_BULLET]The Free Companies are born as your vassal, in two cities within 8 plots of your borders.[NEWLINE][ICON_BULLET]They start with six Mercenaries, 1000 gold and the Captain-General.[NEWLINE][ICON_BULLET]Once per game.",
    "TXT_KEY_BUILDING_PALACE_FREE_COMPANIES": "Palace",
    "TXT_KEY_TRAIT_FREE_COMPANIES": "Free Companies",
    "TXT_KEY_TRAIT_FREE_COMPANIES_SHORT": "Free Companies",
    "TXT_KEY_UNIT_CAPTAIN_GENERAL": "Captain-General",
    "TXT_KEY_UNIT_CAPTAIN_GENERAL_PEDIA": "The Captain-General of the Free Companies has sold his sword to every crown on the continent, and kept every contract.",
    "TXT_KEY_UNIT_CAPTAIN_GENERAL_STRATEGY": "A hero that hits hard: buy the army around him.",
    "TXT_KEY_CIV_FREE_COMPANIES_DESC": "The Free Companies",
    "TXT_KEY_CIV_FREE_COMPANIES_SHORT_DESC": "Free Companies",
    "TXT_KEY_CIV_FREE_COMPANIES_ADJECTIVE": "Condottieri",
    "TXT_KEY_CIV_FREE_COMPANIES_HELP": "[ICON_BULLET]Its cities make double gold (+100%).[NEWLINE][ICON_BULLET]It buys units at 2 gold per hammer left, under any civic.[NEWLINE][ICON_BULLET]Hero: the Captain-General.",
    "TXT_KEY_CIV_FREE_COMPANIES_PEDIA": "The Free Companies are mercenary bands made a state: their cities are paymasters' halls, and their wealth buys the next war.",
    "TXT_KEY_CITY_FREE_COMPANIES_1": "Condotta",
    "TXT_KEY_CITY_FREE_COMPANIES_2": "Soldano",
    "TXT_KEY_CITY_FREE_COMPANIES_3": "Ventimar",
    "TXT_KEY_CITY_FREE_COMPANIES_4": "Lancegate",
    "TXT_KEY_CITY_FREE_COMPANIES_5": "Marchetto",
    "TXT_KEY_CITY_FREE_COMPANIES_6": "Bravoria",
    "TXT_KEY_CITY_FREE_COMPANIES_7": "Capitano",
    "TXT_KEY_CITY_FREE_COMPANIES_8": "Fortezza",
    "TXT_KEY_LEADER_VESK": "Bartolo Vesk",
    "TXT_KEY_LEADER_VESK_PEDIA": "Bartolo Vesk counts coin as other men count heads, and he has never yet lost the count."
  }
