  "text": {
    "TXT_KEY_TECH_CARD_FEY_COURT": "The Fey Court Awakens",
    "TXT_KEY_TECH_CARD_FEY_COURT_HELP": "[ICON_BULLET]World spell, once: the Fey Court is born as your vassal, of the Fellowship of Leaves.[NEWLINE][ICON_BULLET]Needs an unowned forest region of 12 or more forest plots; its two cities stand in it.[NEWLINE][ICON_BULLET]It starts with two Satyrs, two Fawns, two Treants and the Erlking, a hero (large, tier 4, HP 160, attack 110).[NEWLINE][ICON_BULLET]Its units have +2 first strikes and +50% defence in forest.",
    "TXT_KEY_TECH_CARD_FEY_COURT_PEDIA": "Where the old woods are deepest, the fey still hold court.[NEWLINE][NEWLINE]Expert: wake them in the forest between you and a rival; under the trees nobody fights them well.",
    "TXT_KEY_SPELL_FEY_COURT": "The Fey Court Awakens",
    "TXT_KEY_SPELL_FEY_COURT_HELP": "[ICON_BULLET]The Fey Court is born as your vassal, in two cities of the largest unowned forest region (12 forest plots or more).[NEWLINE][ICON_BULLET]It starts with two Satyrs, two Fawns, two Treants and the Erlking.[NEWLINE][ICON_BULLET]Once per game.",
    "TXT_KEY_BUILDING_PALACE_FEY_COURT": "Palace",
    "TXT_KEY_PROMOTION_FEY_GLAMOUR": "Fey Glamour",
    "TXT_KEY_PROMOTION_FEY_GLAMOUR_HELP": "[ICON_BULLET]+2 first strikes in forest.",
    "TXT_KEY_UNIT_ERLKING": "Erlking",
    "TXT_KEY_UNIT_ERLKING_PEDIA": "The Erlking rides at the head of the hunt. Where he passes, the forest closes behind him.",
    "TXT_KEY_UNIT_ERLKING_STRATEGY": "A hero above its era: fight in the forest, where the Glamour adds its first strikes and defence.",
    "TXT_KEY_CIV_FEY_COURT_DESC": "The Fey Court",
    "TXT_KEY_CIV_FEY_COURT_SHORT_DESC": "Fey Court",
    "TXT_KEY_CIV_FEY_COURT_ADJECTIVE": "Fey",
    "TXT_KEY_CIV_FEY_COURT_HELP": "[ICON_BULLET]Its units: +2 first strikes and +50% defence in forest.[NEWLINE][ICON_BULLET]State religion: the Fellowship of Leaves.[NEWLINE][ICON_BULLET]Hero: the Erlking.",
    "TXT_KEY_CIV_FEY_COURT_PEDIA": "The Fey Court is the old people of the deep woods: satyrs, fawns and the walking trees, ruled from halls no axe has found.",
    "TXT_KEY_CITY_FEY_COURT_1": "Thornhall",
    "TXT_KEY_CITY_FEY_COURT_2": "Gloaming",
    "TXT_KEY_CITY_FEY_COURT_3": "Elderglade",
    "TXT_KEY_CITY_FEY_COURT_4": "Hollowmere",
    "TXT_KEY_CITY_FEY_COURT_5": "Briarwood",
    "TXT_KEY_CITY_FEY_COURT_6": "Moonvale",
    "TXT_KEY_CITY_FEY_COURT_7": "Ashgrove",
    "TXT_KEY_CITY_FEY_COURT_8": "Wildmere",
    "TXT_KEY_LEADER_AINE": "Aine",
    "TXT_KEY_LEADER_AINE_PEDIA": "Queen Aine of the Fey Court remembers the woods before the first axe. She has not forgiven it."
  }
}
