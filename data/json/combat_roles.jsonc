// Engagement roles (GAMEOPTION_ENGAGEMENTS; this game's own rules, phase 6 of the owner's spec
//     "Engagement combat", revision 4: formation battles; docs/ENGAGEMENTS.md).
//     Every land unit type has one role. It comes from the unit's CombatRole if set, else from
//     the first role here whose DefaultUnitCombats holds the unit's unit combat and whose
//     DefaultFreePromotion, if any, the unit type has free (roles with a promotion are tried first),
//     else from the bDefault role (monstrous units and summons with no unit combat). A unit of
//     FromRole holding FromPromotion takes the role instead (a Frontline unit with Formation is a
//     Screen). Sea and air units have no role. A type without strength (a Worker, a Settler, a great
//     person) has one too: whether a unit fights is its own strength, which promotions can add to
//     (a Worker that takes the Godslayer is a 3/3 Frontline unit).
//
//     A unit's numbers (hit points, attack, defence, magic, accuracy, evasion, crit, speed) are
//         its own stat sheet's (`stats` in units.jsonc: docs/UNIT_STATS.md), not its role's.
//     bAntiFlank: whatever an enemy flanker (a role with a CHARGE) can reach, units of this role in
//         its reach are taken first.
//     FrontRow / MiddleRow / RearRow: what a unit of the role does from that row of its side's
//         grid: iActions actions of its Action each round (one per pass); tier 4 units and heroes get
//         ENGAGEMENT_EXTRA_ACTIONS more in the row with the most (the first such).
//         Action: STRIKE (melee on the front unit of an enemy lane; a crit knocks it back a row),
//         CHARGE (where flanking works, anyone on the field, the highest threat for its HP left,
//         harder in the first round; elsewhere a strike), STAB (any enemy), SHOOT (the backmost
//         unit of an enemy lane), SPELL (the backmost unit of an enemy lane: the strongest damage
//         spell the unit knows, with a splash, else a magic bolt), BOMBARD (the backmost unit of
//         an enemy lane), HEAL (the most hurt ally), NONE (iActions 0).
//     HomeRow (FRONT, MIDDLE, REAR): the row the auto formation puts a unit of the role in;
//     iAutoPick: the auto formation's role order (it takes one unit of each role in this order,
//         then the rest in it).
[
  {
    "type": "COMBATROLE_FRONTLINE",
    "description": "TXT_KEY_COMBATROLE_FRONTLINE",
    "help": "TXT_KEY_COMBATROLE_FRONTLINE_HELP",
    "front_row": {"action": "STRIKE", "actions": 2},
    "middle_row": {"action": "STRIKE", "actions": 1},
    "rear_row": {"action": "STRIKE", "actions": 1},
    "home_row": "FRONT",
    "auto_pick": 2,
    // the spec: melee, animals, beasts, monstrous units, summons; recon units fight as frontline
    "default_unit_combats": ["UNITCOMBAT_MELEE", "UNITCOMBAT_ANIMAL", "UNITCOMBAT_BEAST", "UNITCOMBAT_RECON"],
    "default": true
  },
  {
    "type": "COMBATROLE_SCREEN",
    "description": "TXT_KEY_COMBATROLE_SCREEN",
    "help": "TXT_KEY_COMBATROLE_SCREEN_HELP",
    "anti_flank": true,
    "front_row": {"action": "STRIKE", "actions": 2},
    "middle_row": {"action": "STRIKE", "actions": 1},
    "rear_row": {"action": "STRIKE", "actions": 1},
    "home_row": "FRONT",
    "auto_pick": 1,
    // the owner's answer Q7: Formation (anti-mounted) makes a frontline unit a screen
    "from_role": "COMBATROLE_FRONTLINE",
    "from_promotion": "PROMOTION_FORMATION"
  },
  {
    "type": "COMBATROLE_FLANKER",
    "description": "TXT_KEY_COMBATROLE_FLANKER",
    "help": "TXT_KEY_COMBATROLE_FLANKER_HELP",
    "front_row": {"action": "CHARGE", "actions": 2},
    "middle_row": {"action": "STRIKE", "actions": 1},
    "rear_row": {"action": "STRIKE", "actions": 1},
    "home_row": "FRONT",
    "auto_pick": 4,
    "default_unit_combats": ["UNITCOMBAT_MOUNTED"]
  },
  {
    "type": "COMBATROLE_ASSASSIN",
    "description": "TXT_KEY_COMBATROLE_ASSASSIN",
    "help": "TXT_KEY_COMBATROLE_ASSASSIN_HELP",
    "front_row": {"action": "STAB", "actions": 1},
    "middle_row": {"action": "STAB", "actions": 2},
    "rear_row": {"action": "STAB", "actions": 1},
    "home_row": "MIDDLE",
    "auto_pick": 8,
    // the owner's answer Q6: recon units with Marksman free (every FfH assassin)
    "default_unit_combats": ["UNITCOMBAT_RECON"],
    "default_free_promotion": "PROMOTION_MARKSMAN"
  },
  {
    "type": "COMBATROLE_ARCHER",
    "description": "TXT_KEY_COMBATROLE_ARCHER",
    "help": "TXT_KEY_COMBATROLE_ARCHER_HELP",
    "front_row": {"action": "SHOOT", "actions": 1},
    "middle_row": {"action": "SHOOT", "actions": 2},
    "rear_row": {"action": "SHOOT", "actions": 2},
    "home_row": "MIDDLE",
    "auto_pick": 3,
    // archers, and the Airship (the only land unit with UNITCOMBAT_NAVAL)
    "default_unit_combats": ["UNITCOMBAT_ARCHER", "UNITCOMBAT_NAVAL"]
  },
  {
    "type": "COMBATROLE_SIEGE",
    "description": "TXT_KEY_COMBATROLE_SIEGE",
    "help": "TXT_KEY_COMBATROLE_SIEGE_HELP",
    "front_row": {"action": "NONE"},
    "middle_row": {"action": "BOMBARD", "actions": 1},
    "rear_row": {"action": "BOMBARD", "actions": 2},
    "home_row": "REAR",
    "auto_pick": 7,
    "default_unit_combats": ["UNITCOMBAT_SIEGE"]
  },
  {
    "type": "COMBATROLE_ARCANE",
    "description": "TXT_KEY_COMBATROLE_ARCANE",
    "help": "TXT_KEY_COMBATROLE_ARCANE_HELP",
    "front_row": {"action": "STRIKE", "actions": 1},
    "middle_row": {"action": "SPELL", "actions": 1},
    "rear_row": {"action": "SPELL", "actions": 2},
    "home_row": "REAR",
    "auto_pick": 5,
    // mages; the religions' fighters are Frontline by their CombatRole
    "default_unit_combats": ["UNITCOMBAT_ADEPT"]
  },
  {
    "type": "COMBATROLE_DIVINE",
    "description": "TXT_KEY_COMBATROLE_DIVINE",
    "help": "TXT_KEY_COMBATROLE_DIVINE_HELP",
    "front_row": {"action": "STRIKE", "actions": 1},
    "middle_row": {"action": "HEAL", "actions": 1},
    "rear_row": {"action": "HEAL", "actions": 2},
    "home_row": "MIDDLE",
    "auto_pick": 6,
    // priests and disciples; the religions' fighters are Frontline by their CombatRole
    "default_unit_combats": ["UNITCOMBAT_DISCIPLE"]
  }
]
