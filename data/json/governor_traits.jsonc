// Governor traits (this game's governors, docs/GOVERNORS.md; not in FFH2): how a governor judges,
//     never a modifier of its city. A governor has one with GOVERNOR_TRAIT_CHANCE %, drawn
//     uniformly. defenders: added to its city's garrison quota; ambitious: it prefers the costliest
//     building it may build.
[
  {
    "type": "GOVERNORTRAIT_CAUTIOUS",
    "description": "TXT_KEY_GOVERNORTRAIT_CAUTIOUS",
    "help": "TXT_KEY_GOVERNORTRAIT_CAUTIOUS_HELP",
    "defenders": 1
  },
  {
    "type": "GOVERNORTRAIT_AMBITIOUS",
    "description": "TXT_KEY_GOVERNORTRAIT_AMBITIOUS",
    "help": "TXT_KEY_GOVERNORTRAIT_AMBITIOUS_HELP",
    "ambitious": true
  }
]
