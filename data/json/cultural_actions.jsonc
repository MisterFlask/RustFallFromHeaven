// Cultural channels (this game's own rules, docs/CULTURE.md; docs/PERSONS.md, "The fourth build").
//     A civilization that can have Houses has at most one channel, a standing order until it
//     changes it: every city diverts half its culture (CULTURE_CHANNEL_PERCENT) into it. The
//     diverted culture reaches neither the cities' culture nor their plots; its effect falls with
//     the square of the distance (CULTURE_CHANNEL_FULL_RANGE, CULTURE_CHANNEL_RANGE).
//
//     Hostile: NEVER, ALWAYS, or DIFFERENT_STATE_RELIGION (only when the target has a state
//              religion other than the one spread). Hostile channels are not acts of war.
//     Effect:  COURT (a House of another realm: its favour toward the caster, which splits the
//              House at the requirement), GUARD (one of the caster's own Houses: every courter's
//              favour at it falls) or SPREAD_RELIGION (a chance a turn that a religion of the
//              caster's cities spreads to one of the target's cities); the magnitudes are the
//              CULTURE_* defines of rules_defines.jsonc
[
  {
    "type": "CULTURALACTION_COURT_HOUSE",
    "description": "TXT_KEY_CULTURALACTION_COURT_HOUSE",
    "help": "TXT_KEY_CULTURALACTION_COURT_HOUSE_HELP",
    "hostile": "ALWAYS",
    "effect": "COURT"
  },
  {
    "type": "CULTURALACTION_GUARD_HOUSE",
    "description": "TXT_KEY_CULTURALACTION_GUARD_HOUSE",
    "help": "TXT_KEY_CULTURALACTION_GUARD_HOUSE_HELP",
    "hostile": "NEVER",
    "effect": "GUARD"
  },
  {
    "type": "CULTURALACTION_SPREAD_RELIGION",
    "description": "TXT_KEY_CULTURALACTION_SPREAD_RELIGION",
    "help": "TXT_KEY_CULTURALACTION_SPREAD_RELIGION_HELP",
    "hostile": "DIFFERENT_STATE_RELIGION",
    "effect": "SPREAD_RELIGION"
  }
]
