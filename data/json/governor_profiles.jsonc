// Governor profiles (GAMEOPTION_GOVERNORS; this game's own rules, docs/GOVERNORS.md).
//     A governed city builds what its governor's profile leans toward: Flavors weigh the city AI's
//     flavors (FLAVOR_*) the way a leader's do, on the 0-10 scale of these files; Emphasizes are the
//     citizen emphases the governor sets in its city; iDefenders adds to the city's garrison quota.
//     bInterim marks the neutral profile of a city with no governor (an interim governor): the
//     bench never draws it.
[
  {
    "type": "GOVERNORPROFILE_INTERIM",
    "description": "TXT_KEY_GOVERNORPROFILE_INTERIM",
    "help": "TXT_KEY_GOVERNORPROFILE_INTERIM_HELP",
    "interim": true,
    "flavors": {
      "FLAVOR_GROWTH": 2,
      "FLAVOR_PRODUCTION": 2,
      "FLAVOR_GOLD": 2,
      "FLAVOR_SCIENCE": 2,
      "FLAVOR_CULTURE": 2,
      "FLAVOR_RELIGION": 2,
      "FLAVOR_MILITARY": 2
    }
  },
  {
    "type": "GOVERNORPROFILE_STEWARD",
    "description": "TXT_KEY_GOVERNORPROFILE_STEWARD",
    "help": "TXT_KEY_GOVERNORPROFILE_STEWARD_HELP",
    "flavors": {"FLAVOR_GROWTH": 5, "FLAVOR_PRODUCTION": 3},
    "emphasizes": ["EMPHASIZE_FOOD"]
  },
  {
    "type": "GOVERNORPROFILE_SCHOLAR",
    "description": "TXT_KEY_GOVERNORPROFILE_SCHOLAR",
    "help": "TXT_KEY_GOVERNORPROFILE_SCHOLAR_HELP",
    "flavors": {"FLAVOR_SCIENCE": 5, "FLAVOR_GROWTH": 1},
    "emphasizes": ["EMPHASIZE_RESEARCH"]
  },
  {
    "type": "GOVERNORPROFILE_MERCHANT",
    "description": "TXT_KEY_GOVERNORPROFILE_MERCHANT",
    "help": "TXT_KEY_GOVERNORPROFILE_MERCHANT_HELP",
    "flavors": {"FLAVOR_GOLD": 5, "FLAVOR_GROWTH": 1},
    "emphasizes": ["EMPHASIZE_COMMERCE"]
  },
  {
    "type": "GOVERNORPROFILE_ZEALOT",
    "description": "TXT_KEY_GOVERNORPROFILE_ZEALOT",
    "help": "TXT_KEY_GOVERNORPROFILE_ZEALOT_HELP",
    "flavors": {"FLAVOR_RELIGION": 5, "FLAVOR_CULTURE": 3}
  },
  {
    "type": "GOVERNORPROFILE_MARSHAL",
    "description": "TXT_KEY_GOVERNORPROFILE_MARSHAL",
    "help": "TXT_KEY_GOVERNORPROFILE_MARSHAL_HELP",
    "flavors": {"FLAVOR_MILITARY": 5, "FLAVOR_PRODUCTION": 2},
    "emphasizes": ["EMPHASIZE_PRODUCTION"],
    "defenders": 1
  },
  {
    "type": "GOVERNORPROFILE_BUILDER",
    "description": "TXT_KEY_GOVERNORPROFILE_BUILDER",
    "help": "TXT_KEY_GOVERNORPROFILE_BUILDER_HELP",
    "flavors": {"FLAVOR_PRODUCTION": 5, "FLAVOR_GROWTH": 1},
    "emphasizes": ["EMPHASIZE_PRODUCTION"]
  }
]
