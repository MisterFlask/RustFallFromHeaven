  },
  {
    "type": "KEYWORD_SYMPATHY",
    "description": "TXT_KEY_KEYWORD_SYMPATHY",
    "reminder": "TXT_KEY_KEYWORD_SYMPATHY_REMINDER",
    "implies": ["KEYWORD_HOUSE"]
